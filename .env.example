# Opcional: una instalación nueva arranca con docker compose up -d sin .env.
# Si las claves quedan vacías, se generan aleatoriamente en volúmenes privados.
# Para elegir claves propias, define .env antes del primer arranque; Git lo ignora.
# Cambiar .env después no cambia las contraseñas de una base ya inicializada.
DB_NAME=andina_pedidos
DB_USER=andina_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
APP_PORT=8080
MYSQL_PORT=3307

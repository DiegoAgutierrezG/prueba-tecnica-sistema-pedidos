# Opcional para personalizar el entorno local; Docker Compose ya tiene valores
# de demostración para que una copia nueva arranque con docker compose up -d.
# Si creas .env, usa claves propias. .env se ignora en Git.
# Dejar una clave vacía equivale a usar el valor público de demostración.
DB_NAME=andina_pedidos
DB_USER=andina_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
APP_PORT=8080
MYSQL_PORT=3307
